{
  "name": "cineby",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:smoke:auth": "bun run scripts/dev-auth-smoke.ts",
    "test:smoke:tmdb": "bun run scripts/smoke-test.tmdb.ts",
    "cf-typegen": "bunx wrangler types --env-interface CloudflareEnv",
    "deploy:proxy": "bunx wrangler deploy --config workers/stream-proxy/wrangler.jsonc",
    "build:worker": "bunx opennextjs-cloudflare build",
    "deploy:app": "bunx opennextjs-cloudflare build && bunx wrangler deploy"
  },
  "dependencies": {
    "@radix-ui/react-select": "^2.3.7",
    "bcryptjs": "^3.0.3",
    "hls.js": "^1.7.0",
    "next": "^15",
    "react": "^19",
    "react-dom": "^19"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.6",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10",
    "eslint": "^9",
    "eslint-config-next": "^15",
    "postcss": "^8",
    "tailwindcss": "^3.4",
    "typescript": "^5",
    "vitest": "^5.0.3"
  },
  "packageManager": "bun@1.3.14",
  "trustedDependencies": [
    "unrs-resolver"
  ]
}
