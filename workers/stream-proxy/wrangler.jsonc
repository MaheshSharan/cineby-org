{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cineby-stream-proxy",
  "main": "worker.ts",
  "compatibility_date": "2026-10-29",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "vars": {
    "CORS_ALLOWED_ORIGINS": "https://cineby.group,https://www.cineby.group"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.05
  }
}
