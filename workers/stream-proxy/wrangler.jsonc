{
  "$schema": "https://raw.githubusercontent.com/cloudflare/workers-sdk/main/packages/wrangler/config-schema.json",
  "name": "cineby-stream-proxy",
  "main": "worker.ts",
  "compatibility_date": "2026-03-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "routes": [
    {
      "pattern": "proxygloomy.cineby.group",
      "custom_domain": true
    }
  ],
  "vars": {
    // Local development overrides this in .dev.vars (see .dev.vars.example).
    "CORS_ALLOWED_ORIGINS": "https://cineby.group,https://www.cineby.group"
    // STREAM_PROXY_SECRET is a secret: `wrangler secret put STREAM_PROXY_SECRET --config workers/stream-proxy/wrangler.jsonc`
    // and it must equal the main app's STREAM_PROXY_SECRET.
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "redact_query_string": false,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true
    },
    "issues": {
      "enabled": true
    }
  }
}

