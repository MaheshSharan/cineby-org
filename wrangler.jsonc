{
  "$schema": "https://raw.githubusercontent.com/cloudflare/workers-sdk/main/packages/wrangler/config-schema.json",
  "name": "cineby",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-03-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cineby-db",
      "database_id": "d9b17c57-accb-42b2-af82-65a3ef942575",
      "migrations_dir": "migrations"
    }
  ],
  "routes": [
    {
      "pattern": "cineby.group",
      "custom_domain": true
    },
    {
      "pattern": "www.cineby.group",
      "custom_domain": true
    }
  ],
  "vars": {
    // 1. App & Canonical Identity
    "NEXT_PUBLIC_SITE_URL": "https://cineby.group",
    "NEXT_PUBLIC_CONTACT_EMAIL": "contact@cineby.group",
    "NEXT_PUBLIC_LEGAL_CONTACT_EMAIL": "maheshsharan28@gmail.com",

    // 2. TMDB API & Image Assets
    "TMDB_API_URL": "https://db.wecollege.net/3",
    "NEXT_PUBLIC_TMDB_DEFAULT_LANGUAGE": "en",
    "NEXT_PUBLIC_IMAGE_MODE": "wsrv",
    "NEXT_PUBLIC_IMAGE_PROXY_URL": "https://wsrv.nl",
    "NEXT_PUBLIC_TMDB_IMAGE_BASE_URL": "https://image.tmdb.org/t/p",

    // 3. Streaming Infrastructure & Proxy
    "STREAM_PROXY_URL": "https://proxygloomy.cineby.group",
    "M3U8_FETCHER_URL": "https://proxym3u8-tau.vercel.app/api/m3u8",
    "NEXT_PUBLIC_TRAILER_API_URL": "https://trailers.wecollege.net/getOldestTrailer",

    // 4. Provider Switches
    "ENABLE_CINEZO": "true",
    "ENABLE_VIDY": "true",
    "ENABLE_VIXSRC": "false",

    // 5. Media Segment Services
    "INTRODB_API_URL": "https://api.introdb.app",
    "SKIPDB_API_URL": "https://api.skipdb.tv",
    "SEGMENT_PROVIDER_PRIORITY": "introdb,skipdb",

    // 6. Cache & Database (production database is the D1 binding below)
    "CACHE_BACKEND": "redis",
    "UPSTASH_REDIS_REST_URL": "https://sought-cub-298860.upstash.io",
    "CACHE_MAX_ENTRIES": "5000",

    // 7. Authentication & Integrations
    "NEXT_PUBLIC_GOOGLE_CLIENT_ID": "710500048793-55rctnc4coj15s1jvao7l2ouejvpftpn.apps.googleusercontent.com",
    "NEXT_PUBLIC_FLAGS_API_BASE_URL": "https://flagsapi.com",
    "NEXT_PUBLIC_ENABLE_ANALYTICS": "true",
    "NEXT_PUBLIC_GA_MEASUREMENT_ID": "G-GWQTFJK3QW",
    "CORS_ALLOWED_ORIGINS": "https://cineby.group,https://www.cineby.group",
    "LOG_LEVEL": "info"

    // Secrets are never listed here. Set once with `wrangler secret put <NAME>`:
    // TMDB_API_KEY, STREAM_PROXY_SECRET, UPSTASH_REDIS_REST_TOKEN, INTRODB_API_KEY, SKIPDB_API_KEY
  },
  "observability": {
    "enabled": false,
    "head_sampling_rate": 1,
    "redact_query_string": false,
    "logs": {
      "enabled": false,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": false,
      "head_sampling_rate": 1,
      "persist": true
    },
    "issues": {
      "enabled": false
    }
  }
}
