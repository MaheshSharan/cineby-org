{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "thecineby-web",
  "main": "worker.ts",
  "compatibility_date": "2026-10-29",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
    "html_handling": "none"
  },
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cineby-db",
      "database_id": "2c8b732d-8ccf-4b04-aff0-569d6b7d53bf"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "CACHE_KV",
      "id": "9de488a992714878a77fd362aa47ff02"
    }
  ],
  "vars": {
    "PLAYER_MODE": "embed",
    "ENABLE_EMBED_PLAYERS": "true",
    "EMBED_SERVER_PRIORITY": "vidy,framextv,vidrift,vidnest,vixsrc",
    "EMBED_DEFAULT_SERVER": "vidrift",
    "EMBED_LOAD_TIMEOUT_MS": "12000",
    "VIXSRC_EMBED_HOST": "https://vixsrc.to",
    "VIDY_EMBED_HOST": "https://vidy.st",
    "VIDNEST_EMBED_HOST": "https://vidnest.fun",
    "CACHE_BACKEND": "memory",
    "CACHE_MAX_ENTRIES": "5000",
    "DATABASE_PATH": "data/cineby.db",
    "NEXT_PUBLIC_SITE_URL": "https://thecineby.org",
    "NEXT_PUBLIC_CONTACT_EMAIL": "contact@thecineby.org",
    "NEXT_PUBLIC_LEGAL_CONTACT_EMAIL": "contact@thecineby.org",
    "TMDB_API_URL": "https://api.themoviedb.org/3",
    "NEXT_PUBLIC_TMDB_DEFAULT_LANGUAGE": "en",
    "NEXT_PUBLIC_IMAGE_MODE": "wsrv",
    "NEXT_PUBLIC_IMAGE_PROXY_URL": "https://wsrv.nl",
    "NEXT_PUBLIC_TMDB_IMAGE_BASE_URL": "https://image.tmdb.org/t/p",
    "NEXT_PUBLIC_TRAILER_API_URL": "https://trailers.wecollege.net/getOldestTrailer",
    "NEXT_PUBLIC_GOOGLE_CLIENT_ID": "710500048793-55rctnc4coj15s1jvao7l2ouejvpftpn.apps.googleusercontent.com",
    "NEXT_PUBLIC_FLAGS_API_BASE_URL": "https://flagsapi.com",
    "NEXT_PUBLIC_ENABLE_ANALYTICS": "true",
    "NEXT_PUBLIC_GA_MEASUREMENT_ID": "G-JGTQE24FP6",
    "NEXT_PUBLIC_ENABLE_CLARITY": "false",
    "CORS_ALLOWED_ORIGINS": "https://thecineby.org,https://www.thecineby.org",
    "LOG_LEVEL": "info"
  },
  "routes": [
    {
      "pattern": "thecineby.org",
      "custom_domain": true
    },
    {
      "pattern": "www.thecineby.org",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": false
  }
}
