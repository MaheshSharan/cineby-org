# Cineby configuration (Workers Dev / Cloudflare Workers Native, Embed-Only).
# Copy to .env.local for development and fill the blanks.

# ─── 1. App & Canonical Identity ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_CONTACT_EMAIL=contact@cineby.group
NEXT_PUBLIC_LEGAL_CONTACT_EMAIL=contact@cineby.group

# ─── 2. TMDB API & Image Assets ──────────────────────────────────────────────────────────────
TMDB_API_URL=https://api.themoviedb.org/3
TMDB_API_KEY=
NEXT_PUBLIC_TMDB_DEFAULT_LANGUAGE=en
NEXT_PUBLIC_IMAGE_MODE=wsrv
NEXT_PUBLIC_IMAGE_PROXY_URL=https://wsrv.nl
NEXT_PUBLIC_TMDB_IMAGE_BASE_URL=https://image.tmdb.org/t/p
NEXT_PUBLIC_TRAILER_API_URL=https://trailers.wecollege.net/getOldestTrailer

# ─── 3. Player Mode & Embeds ─────────────────────────────────────────────────────────────────
PLAYER_MODE=embed
ENABLE_EMBED_PLAYERS=true
EMBED_SERVER_PRIORITY=vidy,vidnest,vixsrc
EMBED_DEFAULT_SERVER=vidy
EMBED_LOAD_TIMEOUT_MS=12000
VIXSRC_EMBED_HOST=https://vixsrc.to
VIDY_EMBED_HOST=https://vidy.st
VIDNEST_EMBED_HOST=https://vidnest.fun

# ─── 4. Cache & Database ─────────────────────────────────────────────────────────────────────
CACHE_BACKEND=memory
CACHE_MAX_ENTRIES=5000
DATABASE_PATH=data/cineby.db

# ─── 5. Authentication & Integrations ────────────────────────────────────────────────────────
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_FLAGS_API_BASE_URL=https://flagsapi.com
NEXT_PUBLIC_ENABLE_ANALYTICS=false
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_DEVTOOLS_GUARD_ENABLED=false
CORS_ALLOWED_ORIGINS=http://localhost:3000
LOG_LEVEL=debug
