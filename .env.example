# TMDB metadata API configuration.
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local. Nothing here may be hardcoded in source code.

# TMDB API key used by the server for metadata fetching.
# SERVER-ONLY — never reference in client code, never prefix with NEXT_PUBLIC_.
TMDB_API_KEY=

# TMDB API base URL (server-side).
TMDB_API_URL=https://api.themoviedb.org/3

# Default language passed to TMDB queries (e.g. en, de, es, fr, pt).
NEXT_PUBLIC_TMDB_DEFAULT_LANGUAGE=en

# TMDB image CDN base URL (public, safe for the browser).
NEXT_PUBLIC_TMDB_IMAGE_BASE_URL=https://image.tmdb.org/t/p

# Image proxy settings (wsrv.nl or custom proxy; set to false to use raw CDN directly)
NEXT_PUBLIC_ENABLE_IMAGE_PROXY=true
NEXT_PUBLIC_IMAGE_PROXY_URL=https://wsrv.nl

# Flags icon API base URL (public, safe for browser)
NEXT_PUBLIC_FLAGS_API_BASE_URL=https://flagsapi.com

# Database Configuration
# Cloudflare D1 is used in production via the 'DB' binding (configured in wrangler.jsonc).
# For local Node / Bun development, DATABASE_PATH specifies the local SQLite database file path.
DATABASE_PATH=data/cineby.db

# Cloudflare Worker Media / Stream Proxy URL (optional, for CORS & stream piping)
# Example: https://my-stream-proxy.workers.dev
STREAM_PROXY_URL=

# Required in production for signed stream proxy descriptors.
STREAM_PROXY_SECRET=

# Stream Provider Toggles (optional, true/false)
# ENABLE_CINEZO=true
# ENABLE_VIDY=true
# ENABLE_VIXSRC=false

# M3U8 Fetcher URL (used by stream proxy/egress function)
M3U8_FETCHER_URL=

# Cache Backend Configuration (memory | redis)
CACHE_BACKEND=memory
CACHE_MAX_ENTRIES=5000

# Upstash / Redis Configuration (optional, required if CACHE_BACKEND=redis)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# REDIS_URL=

# Google One Tap / OAuth Client ID (public, safe for browser)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Allowed CORS Origins (comma-separated, optional)
# Example: https://cineby.app,https://www.cineby.app
CORS_ALLOWED_ORIGINS=

# Media Segment Providers (Intro / Recap / Outro / Next Episode)
SEGMENT_PROVIDER_PRIORITY=introdb,skipdb

# IntroDB configuration
INTRODB_API_URL=https://api.introdb.app
INTRODB_API_KEY=

# SkipDB configuration
SKIPDB_API_URL=https://api.skipdb.tv
SKIPDB_API_KEY=
