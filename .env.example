# Cineby configuration. Copy to .env.local for development and fill the blanks.
#
# - Same variable names and categories as wrangler.jsonc `vars` (production). The
#   drift test (tests/env-config.test.ts) fails if the two files disagree.
# - Every variable is REQUIRED. There are no fallbacks: a missing value fails fast with a
#   descriptive error. Turn a feature off with an explicit `false`, never by leaving it empty.
#   (A few variables are only required when a related switch is on; noted inline.)
# - Values below are DEVELOPMENT values. The "production:" line shows what wrangler.jsonc uses.
# - Secrets are never committed and never go in wrangler.jsonc: production sets them with
#   `wrangler secret put <NAME>`.
# - NEXT_PUBLIC_* values are visible in the browser and inlined at build time (a change needs a
#   rebuild). Never put a secret behind that prefix.
# - Check this file at any time with `bun run check:env` (also runs before `bun run dev`).

# ─── 1. App & Canonical Identity ─────────────────────────────────────────────────────────────
# production: https://cineby.group
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Footer "Contact" link.  production: contact@cineby.group
NEXT_PUBLIC_CONTACT_EMAIL=contact@cineby.group
# Legal / data-request address shown on the Terms and Privacy pages.
NEXT_PUBLIC_LEGAL_CONTACT_EMAIL=maheshsharan28@gmail.com

# ─── 2. TMDB API & Image Assets ──────────────────────────────────────────────────────────────
# production: https://db.wecollege.net/3 (mirror)   development: official API
TMDB_API_URL=https://api.themoviedb.org/3
# SECRET. https://www.themoviedb.org/settings/api
TMDB_API_KEY=
NEXT_PUBLIC_TMDB_DEFAULT_LANGUAGE=en
# tmdb: straight from the TMDB CDN (JPEG).
# wsrv: the browser asks wsrv.nl directly for resized WebP (no Worker request).
# worker: through the assets Worker (every image costs a Worker request).
# production: wsrv
NEXT_PUBLIC_IMAGE_MODE=wsrv
# Resizing service for the wsrv and worker modes; unused when the mode is tmdb.
# production: https://wsrv.nl  (https://assets.cineby.group for the worker mode)
NEXT_PUBLIC_IMAGE_PROXY_URL=https://wsrv.nl
NEXT_PUBLIC_TMDB_IMAGE_BASE_URL=https://image.tmdb.org/t/p

# ─── 3. Streaming Infrastructure & Proxy ─────────────────────────────────────────────────────
# development: the built-in route. production: https://proxygloomy.cineby.group (stream-proxy worker)
STREAM_PROXY_URL=/api/stream/proxy
# Optional pool of edge worker URLs (comma-separated). Rotates chunks across multiple workers.dev.
STREAM_PROXY_URL_POOL=
# SECRET. Signs stream descriptors; the stream-proxy worker needs the same value.
# Generate: openssl rand -hex 32
STREAM_PROXY_SECRET=
M3U8_FETCHER_URL=https://proxym3u8-tau.vercel.app/api/m3u8
NEXT_PUBLIC_TRAILER_API_URL=https://trailers.wecollege.net/getOldestTrailer

# ─── 4. Provider Switches (true | false) ─────────────────────────────────────────────────────
ENABLE_CINEZO=true
ENABLE_VIDY=true
ENABLE_VIXSRC=false

# ─── 5. Media Segment Services ───────────────────────────────────────────────────────────────
# Comma-separated, in priority order. Allowed: introdb, skipdb
SEGMENT_PROVIDER_PRIORITY=introdb,skipdb
INTRODB_API_URL=https://api.introdb.app
# SECRET. Required while introdb is in SEGMENT_PROVIDER_PRIORITY.
INTRODB_API_KEY=
SKIPDB_API_URL=https://api.skipdb.tv
# SECRET. Required while skipdb is in SEGMENT_PROVIDER_PRIORITY.
SKIPDB_API_KEY=

# ─── 6. Cache & Database ─────────────────────────────────────────────────────────────────────
# memory | redis.  production: redis
CACHE_BACKEND=memory
CACHE_MAX_ENTRIES=5000
# Dedicated internal Redis URL (e.g. redis://cineby-redis:8492)
REDIS_URL=
# Local SQLite file on host/VPS (e.g. /app/data/cineby.db in production container).
DATABASE_PATH=data/cineby.db

# ─── 7. Authentication & Integrations ────────────────────────────────────────────────────────
# Google OAuth client ID (public). Use the same ID as production, or a dev client with
# http://localhost:3000 as an authorised origin.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_FLAGS_API_BASE_URL=https://flagsapi.com
# true | false.  production: true. Keep false locally so development traffic is not tracked.
NEXT_PUBLIC_ENABLE_ANALYTICS=false
# true | false. Blocks inspect shortcuts and sends desktop users to a blank page when DevTools is detected.
# Only active in production builds, so it never affects `bun run dev`.  production: false until verified on real
# devices, then true.
NEXT_PUBLIC_DEVTOOLS_GUARD_ENABLED=false
# GA4 measurement ID. Only required when NEXT_PUBLIC_ENABLE_ANALYTICS=true.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# Comma-separated origins allowed to call the API.  production: https://cineby.group,https://www.cineby.group
CORS_ALLOWED_ORIGINS=http://localhost:3000
# debug | info | warn | error.  production: info
LOG_LEVEL=debug

# ─── 8. Video Ads (HilltopAds VAST played through Google IMA) ────────────────────────────────
# true | false. Kill switch: change the Cloudflare var and redeploy, no rebuild needed.
ENABLE_VIDEO_ADS=false
# VAST tag. Development: Google's public skippable sample. production: the HilltopAds zone URL
# (set it in wrangler.jsonc, never test against the production zone: self-views look like invalid traffic).
VIDEO_AD_TAG_URL=https://pubads.g.doubleclick.net/gampad/ads?iu=/21775744923/external/single_ad_samples&sz=640x480&cust_params=sample_ct%3Dskippablelinear&ciu_szs=300x250%2C728x90&gdfp_req=1&output=vast&unviewed_position_start=1&env=vp&impl=s&correlator=
# Reported in analytics as the ad unit. development: dev. production: 7547805
VIDEO_AD_ZONE_ID=dev
# Minutes between mid-rolls.
VIDEO_AD_COOLDOWN_MIN=15
# TV only: one mid-roll every N episodes started.
VIDEO_AD_EPISODES_BETWEEN=3
# Budget for the ad request. Content starts without an ad when it is exceeded.
VIDEO_AD_REQUEST_TIMEOUT_MS=5000
# Rolling eCPM in USD from the HilltopAds dashboard. Only used for estimated revenue in analytics.
VIDEO_AD_ECPM_USD=1.5
